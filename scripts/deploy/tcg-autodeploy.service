[Unit]
Description=TCG Auto-Deploy Webhook Server
Documentation=https://github.com/your-org/Odoo_TCG
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root

# Environment configuration
# IMPORTANT: Update WEBHOOK_SECRET to match your GitHub webhook secret
Environment=WEBHOOK_SECRET=your-github-webhook-secret
Environment=REPO_PATH=/var/lib/Odoo_TCG
Environment=BRANCH=main

# Working directory (used by git commands)
WorkingDirectory=/var/lib/Odoo_TCG

# Start the webhook server
ExecStart=/usr/bin/python3 /var/lib/Odoo_TCG/scripts/deploy/deploy-webhook.py

# Restart policy
Restart=always
RestartSec=10

# Security hardening (optional)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tcg-autodeploy

[Install]
WantedBy=multi-user.target
