# TCG Automation Configuration
# Copy to .env and fill in your values
# NEVER commit .env to git!

# Odoo Connection
ODOO_URL=http://192.168.10.105:8069
ODOO_DB=TCG-Cards
ODOO_USER=your-email@example.com
ODOO_PASSWORD=your-password

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============================================================
# AUTHENTICATION (REQUIRED for production!)
# ============================================================
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl

# JWT token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Initial admin user (created on first startup if no users exist)
ADMIN_USERNAME=your-admin-username
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password

# ============================================================
# EMAIL NOTIFICATIONS (Optional - for security alerts)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=your-email@gmail.com

# ============================================================
# Brother QL Label Printer
# ============================================================
PRINTER_ENABLED=true
PRINTER_IP=192.168.10.104
PRINTER_PORT=9100
PRINTER_MODEL=QL-800
PRINTER_LABEL_SIZE=29
