# TCG Automation Configuration
# Copy to .env and fill in your values
# NEVER commit .env to git!

# Odoo Connection
ODOO_URL=http://192.168.10.105:8069
ODOO_DB=TCG-Cards
ODOO_USER=your-email@example.com
ODOO_PASSWORD=your-password

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============================================================
# AUTHENTICATION
# ============================================================
# Users log in with their Odoo credentials - no separate user database!
# JWT is used for session tokens only

# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl

# JWT token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# ============================================================
# EMAIL NOTIFICATIONS (Optional - for security alerts)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=your-email@gmail.com

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable/disable application features
FEATURE_SETS_PAGE=false
FEATURE_SCANNER_PAGE=true
FEATURE_INVENTORY_PAGE=true
FEATURE_LABEL_PRINTING=true

# Premium Features (disabled by default)
FEATURE_PORTFOLIO_DASHBOARD=false   # "Wall Street" portfolio analytics
FEATURE_PUBLIC_VAULT=false          # "Digital Vault" public showcase

# ============================================================
# Brother QL Label Printer
# ============================================================
PRINTER_ENABLED=true
PRINTER_IP=192.168.10.104
PRINTER_PORT=9100
PRINTER_MODEL=QL-800
PRINTER_LABEL_SIZE=29

# ============================================================
# Redis (for caching and background tasks)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Meilisearch (for instant card search)
# ============================================================
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=your-master-key-here

# ============================================================
# PostgreSQL (for price history - uses Odoo's database)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=your-odoo-db-password
