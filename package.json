{
  "name": "tcg-inventory",
  "version": "2.0.0",
  "private": true,
  "description": "TCG Card Inventory Management System",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && ../venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev -- --host",
    "install:all": "npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "npm run dev:backend",
    "start:backend": "cd backend && ../venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "setup": "npm run install:all && cd backend && pip install -e .",
    "clean": "rm -rf frontend/node_modules frontend/dist node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}



