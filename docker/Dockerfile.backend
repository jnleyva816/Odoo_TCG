# TCG Backend API Docker Image
FROM python:3.11-slim

LABEL maintainer="joshleyva816@gmail.com"
LABEL description="FastAPI backend for Pokemon TCG Inventory Management"

# Set working directory
WORKDIR /app

# Install system dependencies including fonts for label generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    curl \
    # Fonts for label printing
    fonts-dejavu-core \
    fonts-dejavu-extra \
    fonts-liberation \
    fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f -v

# Copy backend requirements first (for layer caching)
COPY backend/pyproject.toml ./backend/

# Copy backend source
COPY backend/app ./backend/app

# Install backend package
WORKDIR /app/backend
RUN pip install --no-cache-dir -e .

# Back to app root
WORKDIR /app

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${SERVER_PORT}/api/health || exit 1

# Expose port
EXPOSE 8000

# Run the FastAPI server
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
